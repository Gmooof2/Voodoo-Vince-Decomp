#!/bin/sh
# pre-push (T9, phase 1.1): firewall audit of every blob reachable from the pushed commits.
# stdin: "<local ref> <local sha> <remote ref> <remote sha>" per ref. Per line:
#   deletion (local sha all zeros): nothing; new remote ref (remote sha all zeros) or a remote sha absent here:
#   the whole history of the local sha (OLD = the empty tree); else rev-list --objects <remote sha>..<local sha>.
# Python: the first that runs of env PY, .claude/pa.json key "python", python on PATH (3.6 T4). Any non-zero audit
# exit (1 hits, 2 refusal) or no runnable Python blocks.
# 5.5 T14.c2: a private tree (not: config/PUBLIC_TREE and no .claude/pa.json) pushes only to the URL in
# `git config vv.privateRemote` ($2; unset or empty refuses), checked before stdin is read; a public tree needs no key.
# Per ref, after the audit: the fake-diff check (provenance_lint.fake_diff_step) of each pushed commit that touches
# src against its first parent (a root commit: the empty tree); a FAIL blocks; no src dir: skipped.
# T14.c3: whole history walks `rev-list <lsha> --not --remotes -- src` (commits a remote-tracking ref holds were
# checked when first pushed; was: `<lsha> -- src`); the range case walks `<remote sha>..<lsha> -- src`.
# C5: a Python counts only when it prints `ok` (was: `"$c" -c ""` exits 0). S3: in a private tree holding
# config/local_paths.json, AUDIT_PUBLIC_CONFIG and AUDIT_PUBLIC_MANIFEST are unset and `not checked` blocks.
ROOT=$(git rev-parse --show-toplevel) || exit 1
PRIVATE=1
[ -f "$ROOT/config/PUBLIC_TREE" ] && [ ! -f "$ROOT/.claude/pa.json" ] && PRIVATE=0
if [ "$PRIVATE" -eq 1 ]; then
  KEY=$(git config --get vv.privateRemote)
  if [ -z "$KEY" ] || [ "$2" != "$KEY" ]; then
    echo "pre-push: private tree: the remote is not the URL set in git config vv.privateRemote (unset, empty or another URL); push blocked" >&2
    exit 1
  fi
fi
ENV_PY=$PY
PA_PY=$(sed -n 's/.*"python"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$ROOT/.claude/pa.json" 2>/dev/null | head -n 1)
PY=
for c in "$ENV_PY" "$PA_PY" python; do
  if [ -n "$c" ] && [ "$("$c" -c "print('ok')" 2>/dev/null | tr -d '\r')" = ok ]; then PY=$c; break; fi
done
if [ -z "$PY" ]; then
  echo "pre-push: no Python runs (env PY '$ENV_PY', .claude/pa.json python '$PA_PY', python on PATH); set env PY; push blocked" >&2
  exit 1
fi
S3=0
if [ "$PRIVATE" -eq 1 ] && [ -f "$ROOT/config/local_paths.json" ]; then
  S3=1
  unset AUDIT_PUBLIC_CONFIG AUDIT_PUBLIC_MANIFEST
fi
EMPTY_TREE=$(git hash-object -t tree /dev/null) || exit 1
fail=0
while read -r lref lsha rref rsha; do
  [ -z "$lsha" ] && continue
  case "$lsha" in *[!0]*) ;; *) echo "pre-push: $rref deletion, nothing to audit" >&2; continue ;; esac
  old=$rsha
  case "$rsha" in *[!0]*) ;; *) old=$EMPTY_TREE ;; esac
  if [ "$old" != "$EMPTY_TREE" ] && ! git cat-file -e "$old^{commit}" 2>/dev/null; then
    echo "pre-push: remote sha $rsha not in this clone; auditing the whole history of $lsha" >&2
    old=$EMPTY_TREE
  fi
  OUT=$("$PY" "$ROOT/tools/audit_public.py" --range "$old..$lsha" 2>&1)
  rc=$?
  printf '%s\n' "$OUT" >&2
  if [ "$rc" -ne 0 ]; then
    echo "pre-push: audit_public.py --range for $lref -> $rref exit $rc (1 hits, 2 refusal)" >&2
    fail=1
  fi
  if [ "$S3" -eq 1 ]; then
    case "$OUT" in *"not checked"*)
      echo "pre-push: audit_public.py --range for $lref -> $rref left a value class not checked in a private tree; set it in config/local_paths.json" >&2
      fail=1 ;;
    esac
  fi
  [ -d "$ROOT/src" ] || continue
  rng="$old..$lsha"
  [ "$old" = "$EMPTY_TREE" ] && rng="$lsha --not --remotes"
  "$PY" -B -c '
import sys
from pathlib import Path
sys.path.insert(0, sys.argv[1])
import provenance_lint as p
top, rng, empty = Path(sys.argv[2]), sys.argv[3], sys.argv[4]
fails = []
try:
    for c in p.git("rev-list", "--reverse", *rng.split(), "--", "src", cwd=top).split():
        par = p.git("rev-list", "--parents", "-n", "1", c, cwd=top).split()[1:2]
        p.fake_diff_step(top, "src", par[0] if par else empty, c, fails)
except p.Refuse as e:
    sys.exit(f"fake-diff refused: {e}")
for f in fails:
    print(f, file=sys.stderr)
sys.exit(1 if fails else 0)' "$ROOT/tools" "$ROOT" "$rng" "$EMPTY_TREE" </dev/null
  rc=$?
  if [ "$rc" -ne 0 ]; then
    echo "pre-push: fake-diff for $lref -> $rref exit $rc (1 FAIL, else refused)" >&2
    fail=1
  fi
done
if [ "$fail" -ne 0 ]; then
  echo "pre-push: push blocked" >&2
  exit 1
fi
exit 0
